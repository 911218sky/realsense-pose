# =============================================================================
# RealSense Pose - Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed.
# This file is ignored by git (see .gitignore)
# =============================================================================

# =============================================================================
# Server
# =============================================================================
IS_PROD=1
PREFIX=/v1
NGINX_PORT=8100
API_PORT=8100

# =============================================================================
# CORS
# =============================================================================
# Comma-separated origins, leave empty to allow all
# Example: https://example.com,http://localhost:3000
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=

# =============================================================================
# Database
# =============================================================================
# MongoDB (password MUST match existing data if volume already initialized)
MONGO_ROOT_PASSWORD=your_mongo_password_here
MONGO_DB=nycu_rehab
DB_NAME=nycu_rehab
MONGO_PORT=27015

# Redis
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb

# =============================================================================
# Database Storage (optional)
# =============================================================================
# Leave empty to use Docker Volumes (recommended for performance)
# Set to a path to use bind mount (e.g., for external storage)
# 
# Examples:
#   HOST_MONGO_DIR=                    # Use Docker Volume (default, fast)
#   HOST_MONGO_DIR=./data/mongo        # Use local directory
#   HOST_MONGO_DIR=D:\database\mongo   # Use external drive (Windows)
#   HOST_MONGO_DIR=/mnt/nas/mongo      # Use NAS mount (Linux)
#
# HOST_MONGO_DIR=
# HOST_REDIS_DIR=

# =============================================================================
# Automatic Backup (optional)
# =============================================================================
# Backup schedule in cron format (default: 2 AM daily)
BACKUP_CRON=0 2 * * *

# Maximum number of backups to keep
MAX_BACKUPS=7

# Backup storage location
HOST_BACKUP_DIR=./backups

# Backup script location (different for dev vs deploy)
# Dev: ./scripts/backup/backup.sh
# Deploy: ./backup/backup.sh
BACKUP_SCRIPT=./backup/backup.sh

# Timezone for backup schedule
TZ=Asia/Taipei

# =============================================================================
# Authentication (optional)
# =============================================================================
AUTH_ENABLED=1
AUTH_CLIENT_SECRETS=your_client=your_secret_here
AUTH_TIMESTAMP_SKEW_SECONDS=10
AUTH_NONCE_TTL_SECONDS=30
AUTH_MAX_BODY_BYTES=0

# =============================================================================
# Web UI
# =============================================================================
SERVE_WEB=1
# WEB_HOST_DIR=./web

# =============================================================================
# Auto-Update (Watchtower)
# =============================================================================
WATCHTOWER_POLL_INTERVAL=300
WATCHTOWER_CLEANUP=true

# =============================================================================
# Volume Paths
# =============================================================================
HOST_DATA_DIR=./data
HOST_DATASET_DIR=./data/bag
HOST_CONFIGS_DIR=./configs

# =============================================================================
# Docker Images (optional override)
# =============================================================================
# Default: Docker Hub (works globally)
# For China users: uncomment the DaoCloud mirror section below
#
# DaoCloud Mirror Mapping:
#   docker.io  -> docker.m.daocloud.io
#   ghcr.io    -> ghcr.m.daocloud.io
#   gcr.io     -> gcr.m.daocloud.io
#   quay.io    -> quay.m.daocloud.io
#   More: https://github.com/DaoCloud/public-image-mirror
#
# --- DaoCloud Mirror (recommended for China) ---
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx
# MONGO_IMAGE=docker.m.daocloud.io/library/mongo
# REDIS_IMAGE=docker.m.daocloud.io/library/redis
# FAIL2BAN_IMAGE=docker.m.daocloud.io/crazymax/fail2ban
# WATCHTOWER_IMAGE=docker.m.daocloud.io/containrrr/watchtower
# API_IMAGE=ghcr.m.daocloud.io/911218sky/realsense-pose